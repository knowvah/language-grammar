' misc-charts: ChartFirstIndexBar, CommandChartHAxis, CommandChartVAxis, CommandChartBar, CommandChartLine, CommandChartArea, CommandChartScatter, CommandChartLegend, CommandChartStackMode, CommandChartOrientation, CommandChartAnnotation
@startchart
title Revenue
h-axis "Quarter" [Q1, Q2, "Q 3", Q4] spacing 2 label-right grid
v-axis "Sales" -10 --> 100. spacing 12.5 label-top grid
v2-axis "Share" 0 --> 50 ticks [0:"none", 25 : "half" , 50:"all",]
bar <<main>> "North" [10, 20, 30, 40] #3498db labels
  bar "South" [5,15,25,35] #FFF
line "Trend" [12, 18, 28, 38] #ff7f0e v2 labels
area [1,2,3,4] #automatic
scatter "Points" [3, 6, 9, 12] #e74c3c y2 <<triangle>>
legend RIGHT
stackMode stacked
orientation horizontal
annotation "peak" at (Q4, 40) <<arrow>>
annotation "low" at (1.5, -2e1 )
@endchart

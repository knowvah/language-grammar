' style: single line
@startuml
<style>root{FontColor red}</style>
class Foo
@enduml

' style: single line with spaces
@startuml
<style>element {BackgroundColor palegreen;  FontColor blue}</style>
class Foo
@enduml

' style: single line stereotype
@startuml
<style>.foo bar{LineColor red} root{}</style>
class Foo
@enduml

' style: single line blank

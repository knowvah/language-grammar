' style: property forms
@startuml
<style>
root {
LineColor red
FontSize: 12;
LineColor :: red
HyperLinkColor a:b
Foo a,,b
NotAProperty 12
LineColor #FF0000
}
</style>
class Foo
@enduml

' style: value on the next line
@startuml
<style>
root {
LineColor
red
LineColor
: blue
}
</style>
class Foo
@enduml

' style: several statements on a line
@startuml
<style>
root { LineColor red; FontSize 12 } foo { } ; ;
</style>
class Foo
@enduml

